generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserType {
  CUSTOMER
  DRIVER
}

enum ServiceType {
  HOURLY
  PART_TIME
  FULL_TIME
  WEEKLY
  MONTHLY
}

enum RequestStatus {
  PENDING
  ACCEPTED
  REJECTED
}

model User {
  id        String   @id @default(uuid())
  clerkId   String?   @unique
  email     String   @unique
  name      String
  phone     String?
  password  String   
  type      UserType
  createdAt DateTime @default(now())

  driverProfile    DriverProfile?
  sentRequests     ServiceRequest[] @relation("CustomerRequests")
  receivedRequests ServiceRequest[] @relation("DriverRequests")

  @@map("users")
}

model DriverProfile {
  id          String      @id @default(uuid())
  userId      String      @unique
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  serviceType ServiceType
  rate        Float
  experience  Int
  location    String
  bio         String?

  isAvailable Boolean     @default(true)
  createdAt   DateTime    @default(now())

  @@map("driver_profiles")
}

model ServiceRequest {
  id         String        @id @default(uuid())

  customerId String
  customer   User          @relation("CustomerRequests", fields: [customerId], references: [id])

  driverId   String
  driver     User          @relation("DriverRequests", fields: [driverId], references: [id])

  serviceType ServiceType
  location    String
  message     String?

  status      RequestStatus @default(PENDING)

  createdAt   DateTime      @default(now())

  @@map("service_requests")
}
